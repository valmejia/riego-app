# Copia este archivo como .env y rellena los valores. NO subas .env al repo.
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/hydracloud
PORT=5000

# Token que usan Make y el panel web para crear comandos (POST).
# Genera uno largo, p. ej.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=cambia-esto

# Opcional: token que debe enviar el Arduino en /api/comandos/pendiente y /completar.
# Si lo dejas vacío esas rutas siguen abiertas (compatibilidad con el sketch actual).
DEVICE_TOKEN=

# Opcional: orígenes permitidos para CORS, separados por coma. Vacío = cualquiera.
CORS_ORIGIN=

# Minutos tras los cuales un comando pendiente caduca y ya no se ejecuta.
COMANDO_TTL_MIN=10
